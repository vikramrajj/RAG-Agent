    "windows_uninstall_app": {
        "description": "Uninstall a Windows application",
        "keywords": [
            "uninstall",
            "remove app",
            "delete program",
            "uninstall app"
        ],
        "steps": [
            {
                "action": "open",
                "app": "ms-settings:appsfeatures"
            },
            {
                "action": "wait",
                "seconds": 2
            },
            {
                "action": "search",
                "query": "{APP_NAME}"
            },
            {
                "action": "wait",
                "seconds": 1
            },
            {
                "action": "click",
                "text": "{APP_NAME}"
            },
            {
                "action": "wait",
                "seconds": 1
            },
            {
                "action": "click",
                "text": "Uninstall"
            },
            {
                "action": "wait",
                "seconds": 1
            },
            {
                "action": "confirm"
            }
        ],
        "variables": [
            "APP_NAME"
        ],
        "type": "windows"
    },
