{
    "amazon_search": {
        "description": "Search for products on Amazon",
        "keywords": [
            "search amazon",
            "amazon search",
            "find on amazon",
            "look up on amazon"
        ],
        "steps": [
            {
                "action": "goto",
                "url": "https://www.amazon.com"
            },
            {
                "action": "wait",
                "seconds": 1
            },
            {
                "action": "type",
                "selector": "#twotabsearchtextbox",
                "text": "{QUERY}"
            },
            {
                "action": "click",
                "selector": "#nav-search-submit-button"
            },
            {
                "action": "wait",
                "seconds": 2
            }
        ],
        "variables": [
            "QUERY"
        ],
        "type": "browser"
    },
    "amazon_purchase": {
        "description": "Add item to cart on Amazon (search and add first result)",
        "keywords": [
            "buy on amazon",
            "purchase on amazon",
            "order from amazon",
            "add to cart amazon"
        ],
        "steps": [
            {
                "action": "goto",
                "url": "https://www.amazon.com"
            },
            {
                "action": "wait",
                "seconds": 1
            },
            {
                "action": "type",
                "selector": "#twotabsearchtextbox",
                "text": "{PRODUCT}"
            },
            {
                "action": "click",
                "selector": "#nav-search-submit-button"
            },
            {
                "action": "wait",
                "seconds": 2
            },
            {
                "action": "click",
                "selector": "div[data-component-type='s-search-result']:first-child a.s-link-style"
            },
            {
                "action": "wait",
                "seconds": 2
            },
            {
                "action": "click",
                "selector": "#add-to-cart-button"
            },
            {
                "action": "wait",
                "seconds": 2
            }
        ],
        "variables": [
            "PRODUCT"
        ],
        "type": "browser"
    },
